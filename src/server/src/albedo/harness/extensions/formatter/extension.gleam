//// Configure explicit formatting of edited workspace files.

import albedo/harness/extension
import albedo/harness/rpc
import albedo/harness/settings
import albedo/openai_api/types
import gleam/dynamic/decode
import gleam/json
import gleam/result

pub fn extension() -> extension.Extension {
  extension.Extension(
    "formatter",
    "Format explicitly edited files through files.check().",
    ["files", "python"],
    [
      extension.ManagedPlugin(fn(_, _, _) {
        let assert Ok(empty_config) = json.parse("{}", decode.dynamic)
        use config <- result.try(settings.load(
          "formatter",
          decode.dynamic,
          empty_config,
        ))
        Ok(
          extension.Managed(
            ..extension.empty(),
            instructions: "Formatting is an explicit batch check, not a final-reply gate. After completing edits and any manual formatter runs, await files.check() to format pending files and then collect enabled LSP diagnostics in the same call. Use files.check(paths=[...]) for shell-written files or a selected subset. The check validates current disk snapshots and reports reconciled paths; concurrent changes during the check are refused. Review returned changes, diagnostics and errors, and check again after corrections. Do not run checks while still editing their targets. Disabled features are reported, not treated as passes. No final reply is withheld or regenerated by these checks.",
            python_modules: ["formatter"],
            routes: [
              #("formatter", fn(_, method, args) {
                rpc.serve(
                  method,
                  args,
                  fn(method, _) {
                    case method {
                      "formatter.config" -> Ok(types.encode_value(config))
                      _ ->
                        Error(#(
                          "method",
                          "unknown formatter operation: " <> method,
                        ))
                    }
                  },
                  fn(failure) { failure },
                )
              }),
            ],
          ),
        )
      }),
    ],
    fn(_) { Ok(Nil) },
  )
}
